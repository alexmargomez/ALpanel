generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String           @default("") @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Module {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String           @default("") @db.VarChar(255)
  icon        String           @default("fa-cube") @db.VarChar(60)
  sortOrder   Int              @default(0) @map("sort_order")
  permissions RolePermission[]

  @@map("modules")
}

model RolePermission {
  id        Int     @id @default(autoincrement())
  roleId    Int     @map("role_id")
  moduleId  Int     @map("module_id")
  canView   Boolean @default(false) @map("can_view")
  canCreate Boolean @default(false) @map("can_create")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")
  canDeploy Boolean @default(false) @map("can_deploy")
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@index([moduleId])
  @@map("role_permissions")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(100)
  fullName     String    @default("") @map("full_name") @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @default("admin") @db.VarChar(50)
  roleId       Int?      @map("role_id")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  roleRel      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([roleId])
  @@map("users")
}

model DomainRoute {
  id             String   @id @db.VarChar(64)
  domain         String   @unique @db.VarChar(190)
  projectName    String   @map("project_name") @db.VarChar(120)
  frontendTarget String   @map("frontend_target") @db.VarChar(190)
  apiPathPrefix  String   @default("") @map("api_path_prefix") @db.VarChar(120)
  backendTarget  String   @default("") @map("backend_target") @db.VarChar(190)
  sslEnabled     Boolean  @default(true) @map("ssl_enabled")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("domain_routes")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   @db.VarChar(100)
  target    String   @db.VarChar(255)
  ip        String   @db.VarChar(100)
  status    String   @default("ok") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model PanelSetting {
  settingKey   String   @id @map("setting_key") @db.VarChar(64)
  settingValue String   @map("setting_value") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("panel_settings")
}
