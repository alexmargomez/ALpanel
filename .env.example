# ==============================================================================
# ALpanel — Archivo de Configuración de Ejemplo (.env.example)
# Copia este archivo a .env y reemplaza los valores de prueba por los de tu VPS:
# cp .env.example .env
# ==============================================================================

# Puerto donde escuchará la interfaz web de ALpanel
PANEL_PORT=9000

# Credenciales de Administrador del Panel (CAMBIAR EN PRODUCCIÓN)
PANEL_USER=admin
PANEL_PASSWORD=admin_demo_change_me

# Clave secreta para firmar los tokens JWT de sesión (puedes generarla con: openssl rand -hex 32)
PANEL_JWT_SECRET=cambiar_este_secreto_jwt_por_uno_aleatorio_de_64_caracteres

# IP Pública de tu VPS (Si la dejas vacía, ALpanel la detecta automáticamente)
# Ejemplo de prueba (RFC 5737): 203.0.113.10
SERVER_PUBLIC_IP=

# Ruta donde están alojadas las carpetas de tus proyectos en el servidor host
# IMPORTANTE: Mantén el mismo valor en HOST_PROJECTS_PATH y PROJECTS_ROOT
# para que los volúmenes relativos de docker-compose funcionen de forma transparente.
HOST_PROJECTS_PATH=/home/ubuntu
PROJECTS_ROOT=/home/ubuntu

# Socket del motor de Docker del servidor
DOCKER_SOCKET=/var/run/docker.sock
